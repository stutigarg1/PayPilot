APP_ENV=development
AUTH_MODE=local
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./paypilot.db
# Local mode is single-user. Public hosting MUST use AUTH_MODE=supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only Sandbox is supported; there is deliberately no live API switch.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Without a key, a strict rule-based demo parser is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MODEL_DAILY_LIMIT=20
MODEL_GLOBAL_DAILY_LIMIT=100
MODEL_MAX_OUTPUT_TOKENS=512
